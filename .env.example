# AMuBBS 环境配置
# 复制此文件为 .env 并修改配置

# ===== 应用 =====
APP_MODE=single          # single | distributed
APP_DEBUG=false
APP_URL=http://localhost:8000

# ===== 数据库（主库/单机） =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bbs
DB_USERNAME=amubbs
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ===== 数据库读写分离（分布式模式下启用） =====
# DB_READ_HOST=192.168.1.202,192.168.1.203
# DB_READ_PORT=3306

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===== Session =====
SESSION_DRIVER=file      # file | redis
SESSION_LIFETIME=7200
SESSION_REDIS_DB=1

# ===== 缓存 =====
CACHE_DRIVER=redis       # redis | file

# ===== 文件上传 =====
UPLOAD_DRIVER=local      # local | oss | nfs
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=amubbs-uploads
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
