# AMuBBS 环境配置
# 复制此文件为 .env 并修改配置
#
# 共享虚拟主机快速上手：只需要填 DB_* 五项 + APP_KEY，其余保持默认即可。
# 默认 CACHE_DRIVER=auto 会在服务器没有 Redis 时自动使用文件缓存，无需任何扩展。
# 这个文件里的每一项都由代码读取（scripts/check_env.php 会守住这一点，不留死配置）。

# ===== 应用 =====
APP_DEBUG=false
APP_URL=http://localhost:8000

# 应用密钥：用于「记住我」令牌与后台 API Token 的签名（HMAC）。
# 不填也能跑：会在 storage/app_key 里自动生成一个随机密钥并持久化（权限 0600）；
# 多台 Web 节点请显式配置同一个值，否则各节点互相不认对方的令牌：
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ===== 数据库 =====
# 连接类型，目前只实现了 mysql（兼容 MariaDB 10.x / MySQL 5.7+）
# DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bbs
DB_USERNAME=amubbs
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ===== 数据库读写分离（有从库时才配；不配则读连接自动回退主库） =====
# 多台从库用英文逗号分隔
# DB_READ_HOST=192.168.1.202,192.168.1.203
# DB_READ_PORT=3306

# ===== 缓存 =====
# auto  = 有 Redis 就用 Redis，没有就自动用文件缓存（推荐，共享主机默认可用）
# file  = 强制文件缓存，零扩展依赖
# redis = 强制 Redis（连不上会自动降级为文件缓存，不会白屏）
CACHE_DRIVER=auto

# 文件缓存目录，默认 storage/cache/，确保该目录可写
# CACHE_FILE_PATH=
# 过期清理概率分母：平均每 N 次写入触发一次 GC
# CACHE_FILE_GC=200

# ===== Redis（仅当服务器确实有 Redis 时才需要关注） =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===== Session =====
# file  = 默认，写 storage/sessions/（共享主机零依赖）
# redis = 多台 Web 节点共享登录态时用（必须配 Redis）
SESSION_DRIVER=file
SESSION_LIFETIME=7200
SESSION_REDIS_DB=1
# Session 文件目录，默认 storage/sessions/
# SESSION_FILE_PATH=

# ===== 文件上传 =====
# 没有上传驱动开关：附件与图片一律存到 public/uploads/（本地目录）。
# 多台 Web 节点时，把这块目录做成共享存储（NFS / 主机面板的共享目录）挂到各节点的
# public/uploads/ 即可，代码无需改动；对象存储（OSS 等）目前未实现。
